# Copy to .env, adjust, then load it into your shell before running pytest:
#   set -a; source .env; set +a
# (the framework reads plain environment variables and does not load .env files itself)

# Simulator base URL (default: https://qa-simulator.test.bvnk.com)
BVNK_BASE_URL=https://qa-simulator.test.bvnk.com

# Optional: reuse an existing bearer token instead of calling /init for a fresh account.
# Tests mutate balances, so don't share one token between concurrent runs.
# BVNK_TOKEN=

# Optional: per-request timeout in seconds (default: 15)
# BVNK_TIMEOUT=15
